FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl bash ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY benign_loop.sh /usr/local/bin/benign_loop.sh
RUN chmod +x /usr/local/bin/benign_loop.sh

ENTRYPOINT ["/usr/local/bin/benign_loop.sh"]
